<?xml version="1.0" encoding="utf-8"?>
<resources>
    <plurals name="text_archive_summary">
        <item quantity="one">%1$d entry, %2$s unpacked</item>
        <item quantity="other">%1$d entries, %2$s unpacked</item>
    </plurals>
    <plurals name="text_archive_created">
        <item quantity="one">Created %1$s with %2$d file</item>
        <item quantity="other">Created %1$s with %2$d files</item>
    </plurals>
    <plurals name="text_compression_selection_summary">
        <item quantity="one">%1$d selected item</item>
        <item quantity="other">%1$d selected items</item>
    </plurals>
    <plurals name="text_compressing_progress">
        <item quantity="one">Compressing %1$s\n%2$d/%3$d file, %4$s/%5$s read</item>
        <item quantity="other">Compressing %1$s\n%2$d/%3$d files, %4$s/%5$s read</item>
    </plurals>
    <plurals name="text_compressing_progress_unknown_sizes">
        <item quantity="one">Compressing %1$s\nFiles: %2$d/%3$d, %4$s read; %5$d file has unknown size</item>
        <item quantity="other">Compressing %1$s\nFiles: %2$d/%3$d, %4$s read; %5$d files have unknown sizes</item>
    </plurals>
    <plurals name="text_scanning_compression_progress">
        <item quantity="one">Scanning %1$s\n%2$d file found; folders: %3$d</item>
        <item quantity="other">Scanning %1$s\n%2$d files found; folders: %3$d</item>
    </plurals>
    <plurals name="text_extraction_complete">
        <item quantity="one">Extracted %1$d file to %2$s</item>
        <item quantity="other">Extracted %1$d files to %2$s</item>
    </plurals>
    <plurals name="text_folder_details">
        <item quantity="one">%1$d file, %2$s unpacked</item>
        <item quantity="other">%1$d files, %2$s unpacked</item>
    </plurals>
</resources>
